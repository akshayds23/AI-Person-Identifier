# ============================================
# VisionAI Campus - Environment Configuration
# ============================================
# Copy this file to .env and modify as needed.
# All values can be overridden here.
# ============================================

# --- Application ---
APP_NAME=VisionAI Campus
APP_VERSION=1.0.0
APP_LANGUAGE=en

# --- School ---
SCHOOL_NAME=My School
SCHOOL_LOGO_PATH=

# --- Default Admin Credentials (first-run only) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- Camera ---
CAMERA_INDEX=0
CAMERA_RESOLUTION_WIDTH=640
CAMERA_RESOLUTION_HEIGHT=480
CAMERA_FPS=30

# --- AI Models ---
YOLO_MODEL_PATH=models/yolo11n.pt
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_MODEL_DIR=models/insightface

# --- AI Thresholds ---
DETECTION_CONFIDENCE=0.5
RECOGNITION_THRESHOLD=0.6
RECOGNITION_COOLDOWN_SECONDS=30

# --- Storage ---
DATABASE_PATH=data/visionai.db
PHOTOS_DIR=assets/photos
SNAPSHOTS_DIR=assets/snapshots
BACKUPS_DIR=backups
LOGS_DIR=logs

# --- Theme ---
THEME=dark

# --- Performance ---
AI_PROCESS_EVERY_N_FRAMES=3
AUTO_SAVE_INTERVAL_SECONDS=60
MAX_DISAPPEARED_FRAMES=50
TRACKER_LINE_POSITION=0.5
